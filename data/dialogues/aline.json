        {
          "type": "add_affinity",
          "npc": "medium",
          "amount": 2
        }
      ]
    },
    "prece_convite": {
      "text": [
        "Étienne! Que alegria ver a Revista impressa. O professor está radiante.",
        "Antes de cada estudo fazemos alguns minutos de prece em silêncio. Quer nos acompanhar hoje?"
      ],
      "choices": [
        {
          "text": "Fazer a prece em silêncio",
          "next": "prece",
          "actions": [
            {
              "type": "start_quest",
