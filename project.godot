; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jogo Espírita"
config/description="RPG 2D espírita em pixel art — Paris, 1857."
run/main_scene="res://scenes/main/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/managers/game_manager.gd"
InventoryManager="*res://scripts/inventory/inventory_manager.gd"
QuestManager="*res://scripts/quests/quest_manager.gd"
DialogueManager="*res://scripts/dialogue/dialogue_manager.gd"
InteractionManager="*res://scripts/interaction/interaction_manager.gd"
MinigameManager="*res://scripts/minigames/minigame_manager.gd"
SceneManager="*res://scripts/managers/scene_manager.gd"
EncyclopediaManager="*res://scripts/managers/encyclopedia_manager.gd"
LibraryManager="*res://scripts/managers/library_manager.gd"
RelationshipManager="*res://scripts/managers/relationship_manager.gd"
ProgressManager="*res://scripts/managers/progress_manager.gd"
TravelManager="*res://scripts/managers/travel_manager.gd"
SaveManager="*res://scripts/managers/save_manager.gd"
TimeManager="*res://scripts/world/time_manager.gd"
EnvironmentManager="*res://scripts/world/environment_manager.gd"
LifeManager="*res://scripts/life/life_manager.gd"
SocialManager="*res://scripts/social/social_manager.gd"
WorldEventManager="*res://scripts/events/world_event_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://resources/ui/main_theme.tres"

